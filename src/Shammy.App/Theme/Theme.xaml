<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Shammy.Views">

    <FontFamily x:Key="ShammyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="ShammyDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="Fg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Fg2" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="Fg3" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="Fill1" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Fill2" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="Green" Color="#FF30D158" />
    <SolidColorBrush x:Key="Red" Color="#FFFF453A" />
    <SolidColorBrush x:Key="Amber" Color="#FFFFD60A" />
    <!-- Replaced at startup with the user's Windows accent colour. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF" />
    <!-- v2 design: one accent per kind of activity, card surfaces (see Modules/NotchCards.cs). -->
    <SolidColorBrush x:Key="MusicAccent" Color="#FFFF8A3D" />
    <SolidColorBrush x:Key="CalendarAccent" Color="#FF4C9AFF" />
    <SolidColorBrush x:Key="TimerAccent" Color="#FF5AC8FA" />
    <SolidColorBrush x:Key="BatteryAccent" Color="#FF30D158" />
    <SolidColorBrush x:Key="WeatherAccent" Color="#FFFFC233" />
    <SolidColorBrush x:Key="PurpleAccent" Color="#FFB48CFF" />
    <SolidColorBrush x:Key="AlarmAccent" Color="#FFFF453A" />
    <SolidColorBrush x:Key="CardBg" Color="#FF121214" />
    <SolidColorBrush x:Key="CardStroke" Color="#FF1F1F23" />
    <SolidColorBrush x:Key="CardText" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="CardText2" Color="#FFA1A1A6" />

    <!-- Focus Wall (the chosen design language; see .impeccable/surfaces and FOCUSWALL in the redesign notes):
         a deep neutral ground, colour only from each tile's artwork, ONE accent for focus and the primary control. -->
    <FontFamily x:Key="WallFont">pack://application:,,,/Assets/Fonts/#Schibsted Grotesk</FontFamily>
    <FontFamily x:Key="WallFontMedium">pack://application:,,,/Assets/Fonts/#Schibsted Grotesk Medium</FontFamily>
    <FontFamily x:Key="WallFontSemiBold">pack://application:,,,/Assets/Fonts/#Schibsted Grotesk SemiBold</FontFamily>
    <FontFamily x:Key="WallFontExtraBold">pack://application:,,,/Assets/Fonts/#Schibsted Grotesk ExtraBold</FontFamily>
    <SolidColorBrush x:Key="WallGround" Color="#FF0B0B0D" />
    <SolidColorBrush x:Key="WallTile" Color="#FF16161A" />
    <SolidColorBrush x:Key="WallHairline" Color="#FF26282E" />
    <SolidColorBrush x:Key="WallText" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="WallText2" Color="#FFA3A3AB" />
    <SolidColorBrush x:Key="WallAccent" Color="#FF758CFF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF000000" />

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BareTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Context menus (used on notifications) and tooltips, in the Focus Wall look: tile surface, hairline, Wall face. -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource WallTile}" BorderBrush="{StaticResource WallHairline}" BorderThickness="1" CornerRadius="12" Padding="4">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource WallText}" />
        <Setter Property="FontFamily" Value="{StaticResource WallFontMedium}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="12,7">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FF26262C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource WallTile}" />
        <Setter Property="Foreground" Value="{StaticResource WallText}" />
        <Setter Property="BorderBrush" Value="{StaticResource WallHairline}" />
        <Setter Property="FontFamily" Value="{StaticResource WallFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
</ResourceDictionary>
