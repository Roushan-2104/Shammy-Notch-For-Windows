<UserControl x:Class="Shammy.Views.AnswerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440" Height="120">
    <Grid>
        <Grid x:Name="Plain" Margin="24,14,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Command results (timers, music...) show their glyph on a tile square; calculator answers don't. -->
            <Border x:Name="GlyphOrb" Width="44" Height="44" CornerRadius="12" Background="{DynamicResource WallTile}"
                    BorderBrush="{DynamicResource WallHairline}" BorderThickness="1"
                    Margin="0,0,14,0" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="17" Foreground="{DynamicResource WallText}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="Expression" FontFamily="{DynamicResource WallFont}" FontSize="13" Foreground="{DynamicResource WallText2}"
                           TextTrimming="CharacterEllipsis" />
                <!-- The answer is the poster: big and tight (proportional figures: tabular commas read as gaps). -->
                <TextBlock x:Name="Result" FontFamily="{DynamicResource WallFontExtraBold}" FontWeight="ExtraBold" FontSize="40"
                           Foreground="{DynamicResource WallText}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                           LineStackingStrategy="BlockLineHeight" LineHeight="44" />
            </StackPanel>
            <!-- Copy is the answer's one primary action; the others stay quiet. -->
            <StackPanel x:Name="Actions" Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Margin="12,0,0,0">
                <Button x:Name="NoteButton" Style="{StaticResource WallQuietButton}" FontFamily="{StaticResource IconFont}" FontWeight="Normal"
                        FontSize="13" Width="32" Height="32" Padding="0" Content="&#xE70B;"
                        ToolTip="Save as note" AutomationProperties.Name="Save as note" Click="OnSaveNote" />
                <Button x:Name="SearchWebButton" Style="{StaticResource WallQuietButton}" FontFamily="{StaticResource IconFont}" FontWeight="Normal"
                        FontSize="13" Width="32" Height="32" Padding="0" Content="&#xE721;" Margin="6,0,0,0"
                        ToolTip="Search the web instead" AutomationProperties.Name="Search the web instead" Click="OnSearchWeb" />
                <Button x:Name="CopyButton" Style="{StaticResource WallPrimaryButton}" FontFamily="{StaticResource IconFont}" FontWeight="Normal"
                        FontSize="14" Width="36" Height="36" Padding="0" Content="&#xE8C8;" Margin="8,0,0,0"
                        ToolTip="Copy" AutomationProperties.Name="Copy" Click="OnCopy" />
            </StackPanel>
        </Grid>

        <!--
            Circle to search's moment: what you circled, understood on this PC (or a short fact), with what you'd do next.
            The top part is one big target: click it for the full results. The bottom row: the moment's own actions,
            then quiet "send it" icons (Notes, Shelf, phone, Stage).
        -->
        <Grid x:Name="Moment" Margin="22,16,18,16" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="MomentTop" Background="Transparent" Cursor="Hand" ToolTip="Show the full results"
                    MouseLeftButtonUp="OnMomentExpand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MomentOrb" Width="44" Height="44" CornerRadius="12" BorderThickness="1"
                            BorderBrush="{DynamicResource WallHairline}" Margin="0,0,14,0" VerticalAlignment="Top">
                        <TextBlock x:Name="MomentGlyph" Style="{StaticResource Icon}" FontSize="17" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <DockPanel LastChildFill="True">
                            <!-- Where a short answer came from ("Google AI Mode", "Google Translate") -->
                            <Border x:Name="MomentSource" DockPanel.Dock="Right" Height="22" CornerRadius="11" Background="#14FFFFFF" Padding="9,0"
                                    Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="MomentSourceText" FontFamily="{DynamicResource WallFontSemiBold}" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{DynamicResource WallText2}" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="MomentLabel" FontFamily="{DynamicResource WallFont}" FontSize="12.5" Foreground="{DynamicResource WallText2}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="MomentTitle" FontFamily="{DynamicResource WallFont}" FontWeight="Bold" FontSize="23"
                                   Foreground="{DynamicResource WallText}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                   LineStackingStrategy="BlockLineHeight" LineHeight="29" />
                        <TextBlock x:Name="MomentBody" FontFamily="{DynamicResource WallFont}" FontSize="12.5" Foreground="{DynamicResource WallText2}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0,3,0,0" Visibility="Collapsed" />
                        <!-- A short answer (AI Mode's first lines, a translation): words, a few lines -->
                        <TextBlock x:Name="MomentAnswer" FontFamily="{DynamicResource WallFontMedium}" FontWeight="Medium" FontSize="15"
                                   Foreground="{DynamicResource WallText}" TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="86"
                                   LineStackingStrategy="BlockLineHeight" LineHeight="21" Margin="0,8,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Foreground="{DynamicResource WallText2}" Opacity="0.7"
                               VerticalAlignment="Top" Margin="10,4,0,0" />
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel x:Name="MomentActions" Orientation="Horizontal" />
                <StackPanel x:Name="SendRow" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" />
            </Grid>
            <!-- "Or say or type what to do": a silent circle's own question box (Enter runs it) -->
            <Border x:Name="MomentAsk" Grid.Row="2" Height="36" CornerRadius="18" Background="#12FFFFFF" BorderBrush="#17FFFFFF" BorderThickness="1"
                    Padding="13,0" Margin="0,10,0,0" Visibility="Collapsed" Cursor="IBeam">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="13" Foreground="{DynamicResource WallText2}" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="MomentAskHint" Grid.Column="1" Text="Or say or type what to do" FontFamily="{DynamicResource WallFont}" FontSize="13"
                               Foreground="{DynamicResource WallText2}" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="MomentAskBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource WallText}"
                             CaretBrush="{DynamicResource WallText}" FontFamily="{DynamicResource WallFont}" FontSize="13" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Say or type what to do" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
