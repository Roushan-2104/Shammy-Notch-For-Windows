<UserControl x:Class="Shammy.Views.NotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Shammy.Ui"
             xmlns:views="clr-namespace:Shammy.Views"
             Width="460" Height="104" Background="Transparent" Cursor="Hand">
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Remind me in 1 hour" Click="OnRemind" />
            <MenuItem x:Name="MuteItem" Header="Don't show from this app" Click="OnMute" />
            <MenuItem Header="Dismiss" Click="OnDismiss" />
        </ContextMenu>
    </UserControl.ContextMenu>
    <Grid x:Name="Sheet" Margin="16,12,14,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The app's avatar as artwork: its own colours, blurred into a field, with the crisp icon on top. -->
        <Grid x:Name="Avatar" Width="56" Height="56" VerticalAlignment="Center" ClipToBounds="True">
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,56,56" RadiusX="14" RadiusY="14" />
            </Grid.Clip>
            <Border Background="{DynamicResource WallTile}" />
            <Image x:Name="IconField" Width="84" Height="84" Stretch="UniformToFill" Opacity="0.6"
                   HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <BlurEffect Radius="18" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
            <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="20" Foreground="{DynamicResource WallText}" />
            <Image x:Name="IconImage" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
            <Border BorderBrush="{DynamicResource WallHairline}" BorderThickness="1" CornerRadius="14" />
        </Grid>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <Grid>
                <views:TrackedText x:Name="AppText" HorizontalAlignment="Left" Margin="0,0,96,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="MoreBadge" BorderBrush="{DynamicResource WallHairline}" BorderThickness="1" ui:Capsule.Round="True"
                            Padding="7,1" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock x:Name="MoreText" FontFamily="{DynamicResource WallFontSemiBold}" FontWeight="SemiBold" FontSize="10.5"
                                   Foreground="{DynamicResource WallText2}" Typography.NumeralAlignment="Tabular" />
                    </Border>
                    <TextBlock x:Name="TimeText" FontFamily="{DynamicResource WallFont}" FontSize="11.5" Foreground="{DynamicResource WallText2}"
                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    <!-- Hovering holds the notification on screen; say so where the time was. -->
                    <views:TrackedText x:Name="HeldText" Text="Held" FontSize="10" Foreground="{DynamicResource WallText}" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="TitleText" FontFamily="{DynamicResource WallFont}" FontWeight="Bold" FontSize="14"
                       Foreground="{DynamicResource WallText}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
            <TextBlock x:Name="BodyText" FontFamily="{DynamicResource WallFont}" FontSize="12.5" Foreground="{DynamicResource WallText2}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,1,0,0" />
        </StackPanel>

        <Button x:Name="DismissButton" Grid.Column="2" Style="{StaticResource WallIconButton}" Content="&#xE711;" FontSize="9"
                Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4"
                ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Click="OnDismiss" Visibility="Hidden" />
    </Grid>
</UserControl>
