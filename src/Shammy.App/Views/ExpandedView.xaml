<UserControl x:Class="Shammy.Views.ExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Shammy.Views"
             xmlns:ui="clr-namespace:Shammy.Ui"
             Width="720" Height="250" Focusable="True" FocusVisualStyle="{x:Null}">
    <!-- The open notch as a Focus Wall (Wall.dc.html): pet-eyes home, tracked chips and search on top; below, one
         rail of artwork tiles with the focused one grown, or one card opened in place out of its tile. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="WallSurfaceHover" Color="#FF1E1E24" />

        <!-- A chip: tracked uppercase text, quiet; the open view's chip is white with a 1 px underline, not a pill. -->
        <Style x:Key="NotchChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource WallText2}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource WallFocusRing}" />
            <Setter Property="ui:FocusKit.KeepsTextFocus" Value="True" />
            <Setter Property="ui:Press.Feedback" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="7,0" VerticalAlignment="Center" />
                            <Border x:Name="Underline" Height="1" Margin="7,0,7,3" VerticalAlignment="Bottom" SnapsToDevicePixels="True"
                                    Background="{DynamicResource WallText}" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="views:TabHover.Armed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource WallText}" />
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource WallText}" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Body" Margin="20,12,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top row: the pet's eyes (home), chips, search -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- The way into the guide: everything Shammy does, in one place. Shown once the guide has registered. -->
            <Border x:Name="GuideButton" Grid.Column="3" Width="32" Height="32" CornerRadius="16" Margin="8,0,0,0" Cursor="Hand" Visibility="Collapsed"
                    MouseLeftButtonUp="OnGuideClicked" ToolTip="What Shammy can do" AutomationProperties.Name="What Shammy can do">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource WallTile}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource WallSurfaceHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="?" FontFamily="{StaticResource WallFontExtraBold}" FontWeight="ExtraBold" FontSize="15" Foreground="{DynamicResource WallText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Border>
            <Button x:Name="HomeButton" Width="54" Height="32" Margin="0,0,12,0" Cursor="Hand" ToolTip="Home"
                    FocusVisualStyle="{StaticResource WallFocusRing}" ui:FocusKit.KeepsTextFocus="True" ui:Press.Feedback="True"
                    AutomationProperties.Name="Home, Shammy" Click="OnHomeClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{StaticResource WallTile}" CornerRadius="16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="9" Height="14" CornerRadius="4.5" Background="{DynamicResource WallText}" />
                                <Border Width="9" Height="14" CornerRadius="4.5" Background="{DynamicResource WallText}" Margin="9,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource WallSurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <views:ChipPanel x:Name="ChipStrip" Grid.Column="1" Gap="2" Margin="0,0,12,0" />
            <Border x:Name="SearchPill" Grid.Column="2" Width="212" Height="32" CornerRadius="10" Cursor="IBeam"
                    MouseLeftButtonUp="OnSearchClicked" AutomationProperties.Name="Search Shammy">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource WallTile}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource WallSurfaceHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <Viewbox Width="15" Height="15" IsHitTestVisible="False">
                        <Canvas Width="24" Height="24">
                            <Path Data="M11 4a7 7 0 1 1 0 14a7 7 0 1 1 0-14z M20 20l-3.5-3.5" Stroke="{DynamicResource WallText2}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Search or hold Right Alt" FontFamily="{StaticResource WallFontMedium}" FontWeight="Medium" FontSize="13"
                               Foreground="{DynamicResource WallText2}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- The rail: tiles are placed in code (Rail.cs); the strip moves to keep the focused tile in view -->
        <Canvas x:Name="Rail" Grid.Row="1" Height="176" Margin="0,6,0,0" VerticalAlignment="Top" AutomationProperties.Name="Widgets">
            <Canvas x:Name="RailStrip" />
        </Canvas>
        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="Nothing going on · press Right Alt to search" FontFamily="{StaticResource WallFontMedium}"
                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource WallText2}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />

        <!-- One card opened in place -->
        <Grid x:Name="DetailFrame" Grid.Row="1" Width="924" Height="248" Margin="0,12,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
              Visibility="Collapsed">
            <ContentControl x:Name="DetailContent" Focusable="False" />
            <!-- A Wall detail's frame line and Back (on its art panel) -->
            <Border x:Name="DetailLine" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource WallHairline}" IsHitTestVisible="False" />
            <!-- Other details: a Back + title row above them -->
            <StackPanel x:Name="DetailHeader" Orientation="Horizontal" Height="32" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Collapsed">
                <Button x:Name="HeaderBack" Width="32" Height="32" Cursor="Hand" ToolTip="Back (Esc)"
                        FocusVisualStyle="{StaticResource WallFocusRing}" ui:FocusKit.KeepsTextFocus="True" ui:Press.Feedback="True"
                        AutomationProperties.Name="Back" Click="OnBackClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{StaticResource WallTile}" BorderBrush="{DynamicResource WallHairline}" BorderThickness="1" CornerRadius="16">
                                <Viewbox Width="14" Height="14">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M15 5l-7 7 7 7" Stroke="{DynamicResource WallText}" StrokeThickness="2.4" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource WallSurfaceHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="DetailTitle" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource WallFontExtraBold}" FontSize="20"
                           FontWeight="ExtraBold" Foreground="{DynamicResource WallText}" />
            </StackPanel>
            <!-- An older module's tab panel, under the header until it becomes a card -->
            <Grid x:Name="LegacyHost" Margin="0,44,0,0" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
