<UserControl x:Class="Shammy.Views.ExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Shammy.Views"
             xmlns:ui="clr-namespace:Shammy.Ui"
             Width="760" Height="270" Focusable="True" FocusVisualStyle="{x:Null}">
    <!-- The open island (layout "Now + moment row"): the pet's eyes, the right-now sentence, search and "?" on top;
         below, one big now moment with three numbers beside it and a row of six moment-aware tools, or one card
         opened in place with its title and Back. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="WallSurfaceHover" Color="#FF1E1E24" />
    </UserControl.Resources>

    <Grid x:Name="Body" Margin="20,12,20,14">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top row: the pet's eyes (home), the right-now sentence, search, the guide (hidden while a card sheet is open) -->
        <Grid x:Name="TopBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Settings, beside the guide: the same round button. Shown once Settings has registered. -->
            <Border x:Name="SettingsButton" Grid.Column="4" Width="32" Height="32" CornerRadius="16" Margin="6,0,0,0" Cursor="Hand" Visibility="Collapsed"
                    MouseLeftButtonUp="OnSettingsClicked" ToolTip="Settings" AutomationProperties.Name="Settings">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource WallTile}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource WallSurfaceHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource WallText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Border>
            <!-- The way into the guide: everything Shammy does, in one place. Shown once the guide has registered. -->
            <Border x:Name="GuideButton" Grid.Column="3" Width="32" Height="32" CornerRadius="16" Margin="6,0,0,0" Cursor="Hand" Visibility="Collapsed"
                    MouseLeftButtonUp="OnGuideClicked" ToolTip="What Shammy can do" AutomationProperties.Name="What Shammy can do">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource WallTile}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource WallSurfaceHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="?" FontFamily="{StaticResource WallFontExtraBold}" FontWeight="ExtraBold" FontSize="15" Foreground="{DynamicResource WallText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Border>
            <Button x:Name="HomeButton" Width="54" Height="32" Margin="0,0,12,0" Cursor="Hand" ToolTip="Home"
                    FocusVisualStyle="{StaticResource WallFocusRing}" ui:FocusKit.KeepsTextFocus="True" ui:Press.Feedback="True"
                    AutomationProperties.Name="Home, Shammy" Click="OnHomeClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{StaticResource WallTile}" CornerRadius="16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="9" Height="14" CornerRadius="4.5" Background="{DynamicResource WallText}" />
                                <Border Width="9" Height="14" CornerRadius="4.5" Background="{DynamicResource WallText}" Margin="9,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource WallSurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <!-- "Right now · Playing Kesariya · Standup in 12 min": filled in code (Home.cs) -->
            <Border x:Name="NowSentence" Grid.Column="1" Height="32" Margin="0,0,12,0" Background="Transparent" VerticalAlignment="Center">
                <TextBlock x:Name="NowSentenceText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13.5"
                           FontFamily="{StaticResource WallFontSemiBold}" FontWeight="SemiBold" Foreground="{DynamicResource WallText}" />
            </Border>
            <Border x:Name="SearchPill" Grid.Column="2" Height="32" ui:Capsule.Round="True" Cursor="IBeam"
                    MouseLeftButtonUp="OnSearchClicked" AutomationProperties.Name="Search Shammy">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource WallTile}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource WallSurfaceHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" Margin="13,0,15,0" VerticalAlignment="Center">
                    <Viewbox Width="15" Height="15" IsHitTestVisible="False">
                        <Canvas Width="24" Height="24">
                            <Path Data="M11 4a7 7 0 1 1 0 14a7 7 0 1 1 0-14z M20 20l-3.5-3.5" Stroke="{DynamicResource WallText2}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Search or hold Right Alt" FontFamily="{StaticResource WallFontMedium}" FontWeight="Medium" FontSize="13"
                               Foreground="{DynamicResource WallText2}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Home: the big now moment and three numbers, then the six tools (filled in code: Home.cs, Tools.cs) -->
        <Grid x:Name="HomePanel" Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="120" />
                <RowDefinition Height="12" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="HeroHost" CornerRadius="22" BorderThickness="1" Background="#0AFFFFFF" BorderBrush="#1CFFFFFF" ClipToBounds="True"
                        AutomationProperties.LiveSetting="Polite" />
                <StackPanel x:Name="NumbersPanel" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="At a glance" />
            </Grid>
            <StackPanel x:Name="ToolRow" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" AutomationProperties.Name="Tools" />
        </Grid>

        <!-- One card opened in place -->
        <Grid x:Name="DetailFrame" Grid.Row="1" Width="924" Height="248" Margin="0,12,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
              Visibility="Collapsed">
            <ContentControl x:Name="DetailContent" Focusable="False" />
            <!-- A Wall detail's frame line and Back (on its art panel) -->
            <Border x:Name="DetailLine" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource WallHairline}" IsHitTestVisible="False" />
            <!-- Other details: a Back + title row above them -->
            <StackPanel x:Name="DetailHeader" Orientation="Horizontal" Height="32" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Collapsed">
                <Button x:Name="HeaderBack" Width="32" Height="32" Cursor="Hand" ToolTip="Back (Esc)"
                        FocusVisualStyle="{StaticResource WallFocusRing}" ui:FocusKit.KeepsTextFocus="True" ui:Press.Feedback="True"
                        AutomationProperties.Name="Back" Click="OnBackClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{StaticResource WallTile}" BorderBrush="{DynamicResource WallHairline}" BorderThickness="1" CornerRadius="16">
                                <Viewbox Width="14" Height="14">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M15 5l-7 7 7 7" Stroke="{DynamicResource WallText}" StrokeThickness="2.4" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource WallSurfaceHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="DetailTitle" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource WallFontExtraBold}" FontSize="20"
                           FontWeight="ExtraBold" Foreground="{DynamicResource WallText}" />
            </StackPanel>
            <!-- An older module's tab panel, under the header until it becomes a card -->
            <Grid x:Name="LegacyHost" Margin="0,44,0,0" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
