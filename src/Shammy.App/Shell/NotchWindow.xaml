<Window x:Class="Shammy.Shell.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Shammy.Shell"
        xmlns:views="clr-namespace:Shammy.Views"
        Title="Shammy" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        Width="1100" Height="96" Left="0" Top="0" AllowDrop="True"
        FontFamily="{StaticResource ShammyFont}" Foreground="{StaticResource Fg}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
    <Canvas x:Name="Root" Width="1100" Height="1100" AllowDrop="True">
        <shell:NotchShape x:Name="ShadowShape" Width="1100" Height="1100" Opacity="0" IsHitTestVisible="False">
            <shell:NotchShape.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.6" Color="Black" />
            </shell:NotchShape.Effect>
        </shell:NotchShape>
        <shell:EdgeLight x:Name="Edge" Width="1100" Height="1100" />
        <!-- Nearly-invisible hit area: alpha 1/255 still receives the mouse, so hovering just below or beside the pill counts. -->
        <Rectangle x:Name="HitArea" Fill="#01000000" />
        <!-- Messages waiting under the one on screen peek out below it, one or two deep. -->
        <Border x:Name="StackB" Height="30" Background="#FF0A0A0C" BorderBrush="{DynamicResource WallHairline}" BorderThickness="1,0,1,1"
                CornerRadius="0,0,26,26" Visibility="Collapsed" IsHitTestVisible="False" />
        <Border x:Name="StackA" Height="30" Background="#FF0A0A0C" BorderBrush="{DynamicResource WallHairline}" BorderThickness="1,0,1,1"
                CornerRadius="0,0,26,26" Visibility="Collapsed" IsHitTestVisible="False" />
        <shell:NotchShape x:Name="Shape" Width="1100" Height="1100" />
        <Canvas x:Name="ContentHost" Width="1100" Height="1100">
            <views:CompactView x:Name="CompactA" />
            <views:CompactView x:Name="CompactB" />
            <views:ExpandedView x:Name="Expanded" />
            <views:DropView x:Name="DropZone" />
            <views:SearchBarView x:Name="SearchBar" />
            <views:AnswerView x:Name="Answer" />
            <views:ResultView x:Name="Result" />
            <views:NotificationView x:Name="NotificationCard" />
            <ContentControl x:Name="CardHost" Focusable="False" />
        </Canvas>
        <Border x:Name="Bubble" Width="32" Height="32" CornerRadius="16" Background="Black" Opacity="0"
                RenderTransformOrigin="0.5,0.5" Cursor="Hand">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BubbleScale" ScaleX="0.4" ScaleY="0.4" />
            </Border.RenderTransform>
            <ContentControl x:Name="BubbleContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Canvas>
</Window>
