---
import '@fontsource/funnel-display/300.css';
import '@fontsource/funnel-display/600.css';
import '@fontsource/funnel-display/800.css';
import '@fontsource/funnel-sans/400.css';
import '@fontsource/funnel-sans/500.css';
import '@fontsource/funnel-sans/600.css';
import '@fontsource/anek-devanagari/400.css';
import '@fontsource/anek-devanagari/600.css';
import '@fontsource/schibsted-grotesk/600.css';
import '@fontsource/schibsted-grotesk/700.css';
import '@fontsource/geist-mono/400.css';
import '../styles/site.css';
import { REPO, SETUP, GOATCOUNTER } from '../site';

interface Props { title: string; description: string; noindex?: boolean; island?: string }
const { title, description, noindex = false, island } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(`${base}/og.jpg`, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
  <meta name="theme-color" content="#05050A">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Shammy">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={image}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Shammy: the island Windows was missing, a glass island at the top of the screen">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={image}>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml">
  <link rel="icon" href={`${base}/favicon-32.png`} type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`}>
  <link rel="sitemap" href={`${base}/sitemap.xml`}>
  {GOATCOUNTER && <script is:inline data-goatcounter={`https://${GOATCOUNTER}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>}
</head>
<body>
  <a class="skip" href="#main">Skip to the content</a>
  <header class="bar">
    <a class="mark" href={`${base}/`} aria-label="Shammy, home"><span class="eyes" aria-hidden="true"><i></i><i></i></span>shammy</a>
    <nav aria-label="Main">
      <a href={`${base}/#features`}>Features</a>
      <a href={`${base}/whats-new/`}>What's new</a>
      <a href={`${base}/privacy/`}>Privacy</a>
      <a href={REPO}>GitHub</a>
    </nav>
    {island && <span class="bar-island" aria-hidden="true"><span class="eyes"><i></i><i></i></span><span class="bi-label">{island}</span></span>}
    <a class="btn small" href={SETUP}>Download</a>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="foot-row">
      <p class="foot-name">shammy</p>
      <p>A floating island for Windows 10 and 11. Free, MIT licence. No cookies here.</p>
    </div>
    <div class="foot-row small-print">
      <span>Made by <a href="https://github.com/Roushan-2104">Roushan</a></span>
      <span><a href={`${base}/whats-new/`}>What's new</a> · <a href={`${base}/privacy/`}>Privacy</a> · <a href={`${base}/terms/`}>Terms</a> · <a href={REPO}>Source</a></span>
      <span>The pet is asleep down here. Scroll up to wake it.</span>
    </div>
  </footer>
  <script>
    // On the smaller pages, each part rises in once as it arrives. The home page brings its own list.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const parts = document.querySelectorAll('.page > :not(.releases):not(.groups), .page .releases > li, .page .group');
      parts.forEach((el, i) => { el.classList.add('rise'); (el as HTMLElement).style.transitionDelay = `${(i % 4) * 80}ms`; });
      const seen = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); seen.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      parts.forEach((el) => seen.observe(el));
    }
  </script>
</body>
</html>
