---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import { RELEASE as release, SETUP, APK } from '../site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (p: string) => `${base}/img/${p}`;
// The newest version, from the same notes the app shows after an update.
const notes = fs.readFileSync(path.resolve('../src/Shammy.Core/Updates/WhatsNew.cs'), 'utf8');
const version = notes.match(/\["(\d+\.\d+\.\d+)"\]/)?.[1] ?? '';
// Small line icons for the practice desktop (drawn here, no icon font).
const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const icons: Record<string, string> = {
  search: svg('<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>'),
  folder: svg('<path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z"/>'),
  globe: svg('<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.6 2.6 2.6 14.4 0 17M12 3.5c-2.6 2.6-2.6 14.4 0 17"/>'),
  mail: svg('<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4 7 8 6 8-6"/>'),
  term: svg('<rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="m7.5 10 3 2.5-3 2.5M12.5 15.5h4"/>'),
  chat: svg('<path d="M20 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-4.2A8 8 0 1 1 20 11.5z"/>'),
  music: svg('<path d="M9 18V6l10-2v12"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="16.5" cy="16" r="2.5"/>'),
  mic: svg('<rect x="9" y="3.5" width="6" height="11" rx="3"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v2.5"/>'),
};
const ctl = ['<path d="M18 19h10"/>', '<rect x="18" y="14" width="10" height="10" rx="1"/>', '<path d="m18 14 10 10M28 14 18 24"/>']
  .map((d) => `<svg viewBox="0 0 46 38" fill="none" stroke="currentColor" stroke-width="1.1">${d}</svg>`).join('');
const chapters = ['Claude', 'Hinglish', 'Music', 'Phone', 'Stage', 'Alarms', 'Light', 'Get it'];
---
<Base title="Shammy, the island Windows was missing" description="A floating island at the top of Windows: talk in Hinglish and it types, approve Claude from the top of your screen, your phone joins in. About 90 MB, free.">

<section class="journey" aria-label="Shammy, chapter by chapter" data-version={version} data-release={release} data-cover={img('night-song-cover.webp')}>
  <span class="at" id="features" data-at="1"></span>
  <span class="at" id="download" data-at="8"></span>
  <div class="stage" data-scene="open">
    <div class="world" aria-hidden="true"></div>
    <canvas class="gl" aria-hidden="true"></canvas>
    <div class="css-island" aria-hidden="true" data-ui><span class="ci-eyes"><i></i><i></i></span><span class="ci-status">Charging 100%</span><span class="ci-time" data-clock></span></div>
    <div class="moments" aria-hidden="true" data-ui>
      <div class="m glass" data-x="-0.31" data-y="-0.105" data-z="70"><div class="row"><b>Claude Code</b><small>wants to run</small><span class="allow">Allow</span></div><code class="mono code">npm test</code></div>
      <div class="m glass" data-x="0.31" data-y="-0.115" data-z="50"><div class="row"><span class="dot"></span><b class="caps">Dictating</b><small>into WhatsApp</small></div><div class="deva big-deva">हाँ, कल 6 बजे कैफ़े पे मिलते हैं</div></div>
      <div class="m glass" data-x="-0.31" data-y="0.15" data-z="40"><div class="row"><img src={img('night-song-cover.webp')} alt="" width="44" height="44" class="cover"><div><b>Night Song</b><br><small>Nusrat Fateh Ali Khan &amp; Michael Brook</small></div></div></div>
      <div class="m dawn" data-x="0.31" data-y="0.15" data-z="90"><span class="sun"></span><small class="caps">Wake up · dawn</small><div class="dawn-time">6:30<span>AM</span></div></div>
    </div>
    <div class="open-copy">
      <h1 id="hero-title">The island Windows<br>was missing.</h1>
    </div>
    <div class="open-foot">
      <p class="lead">Talk in Hinglish and it types. Approve Claude from the top of your screen. Your phone joins in. All in about 90&nbsp;MB, free.</p>
      <div class="actions">
        <a class="btn" href={SETUP}>Download for Windows</a>
        <a class="link" href="#features">Watch it work</a>
      </div>
    </div>

    <div class="phone" aria-hidden="true" data-ui hidden><div class="ph-screen"><div class="ph-island"><i></i><i></i></div><div class="ph-drop"><b>report.pdf</b><span>From your laptop · tap to open</span></div></div></div>
    <div class="isle" data-ui><div class="isle-in"></div></div>

    <article class="copy away" data-i="1"><h2>Claude asks.<br>You tap Allow.</h2><p class="lead">Your Claude Code sessions live in the island. When one wants to run a command, it asks up there, over whatever app you're in, so you stop missing the moment it needs you.</p></article>
    <article class="copy away" data-i="2"><h2>Talk in Hinglish.<br>It types.</h2><p class="lead">Hold <kbd>Ctrl</kbd> + <kbd>Win</kbd> in any app and talk. Your words show live in the island; let go and they're typed where your cursor is. Say "in Hindi" and it lands in Devanagari.</p></article>
    <article class="copy away" data-i="3"><h2>Your song,<br>in its own colours.</h2><p class="lead">The island takes its light from the cover you're playing. Lyrics scroll in time where the song has them; drag the line to seek, scroll over it for volume.</p></article>
    <article class="copy away" data-i="4"><h2>Your phone<br>joins the island.</h2><p class="lead">Your laptop's notifications drop onto your phone, and your phone's onto the laptop. Answer Claude from your phone. Send files, links and text across your own Wi-Fi.</p><p class="aside"><a class="link" href={APK}>Get Shammy Island for Android</a>, or scan the QR from the island's Phone button.</p></article>
    <article class="copy away" data-i="5"><h2>Read your script.<br>Look at the lens.</h2><p class="lead">Stage puts your script right under the camera and follows your voice. Its ring light lights your face and never shows up in the share.</p></article>
    <article class="copy away" data-i="6"><h2>Alarms in<br>the sky outside.</h2><p class="lead">At 6:30 it's a sunrise. At 2 AM it's the moon, and we don't ask questions. The sky comes up over the first thirty seconds, and one tap stops it.</p><p class="aside" data-sky-note></p></article>
    <article class="copy wide away" data-i="7"><h2>Light enough to forget.</h2>
      <dl class="ledger">
        <div><dt>90</dt><dd>MB of memory while it sits there. Task Manager says so; we asked it twice.</dd></div>
        <div><dt>0</dt><dd>paid AI services. Plain things are answered on your PC.</dd></div>
        <div><dt>26</dt><dd>KB: the frosted glass is a blurred copy of your wallpaper, remade only when it changes.</dd></div>
        <div><dt>105</dt><dd>MB installer. Updates are usually a few MB, in the background.</dd></div>
      </dl>
    </article>
    <article class="copy away" data-i="8"><h2>Get Shammy.<br>It's free.</h2><p class="lead">It runs on Windows 10 (2004 or later) and 11, and updates itself in the background, usually a few MB at a time.</p><p class="aside"><a class="link" href="#try">Or try it first, right here</a> · <a class="link" href={release}>All releases</a></p></article>

    <button type="button" class="sound" aria-pressed="false" aria-label="Island sounds" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/><path class="w1" d="M15.5 9.5a3.5 3.5 0 0 1 0 5"/><path class="w2" d="M18 7a7 7 0 0 1 0 10"/><path class="x" d="m16 9.5 5 5M21 9.5l-5 5"/></svg></button>
    <nav class="rail" aria-label="Chapters" hidden>{chapters.map((c, i) => <button type="button" data-go={i + 1}>{c}</button>)}</nav>
  </div>
</section>

<section class="try" id="try" aria-labelledby="try-title">
  <div class="wrap try-head">
    <h2 id="try-title">Your turn.</h2>
    <p class="lead">A Windows desktop with Shammy on it. Everything on it works.</p>
  </div>
  <div class="desk" data-ui tabindex="0" aria-label="A practice Windows desktop with Shammy on it">
    <div class="wall" aria-hidden="true"></div>
    <canvas class="desk-gl" aria-hidden="true"></canvas>
    <div class="desk-island" aria-live="polite"><div class="di-rest"><span class="eyes"><i></i><i></i></span><span class="di-time" data-clock></span></div></div>

    <div class="win mail" data-ui>
      <div class="win-bar"><span class="app-ic" style="--ic:#4F8CFF" aria-hidden="true"><Fragment set:html={icons.mail} /></span>Mail · Your trip<span class="ctl" aria-hidden="true"><Fragment set:html={ctl} /></span></div>
      <p class="mail-text">Hi Aria, your flight <b class="flight" tabindex="0" role="button" aria-label="Circle the flight number 6E 2134">6E 2134</b> leaves Delhi at 7:40 AM on Friday. Please reach the airport two hours early. Your seat is 14C.</p>
      <p class="hint">Circle the flight number with the mouse, tap it, or Tab to it and press Enter.</p>
    </div>
    <div class="win term" data-ui>
      <div class="win-bar"><span class="app-ic" style="--ic:#C9C5D6" aria-hidden="true"><Fragment set:html={icons.term} /></span>Terminal · claude · login-fix<span class="ctl" aria-hidden="true"><Fragment set:html={ctl} /></span></div>
      <pre class="mono"><span>&gt; fix the failing login test</span>
<span class="ok">● Edited src/auth/session.ts (+6 −2)</span>
<span class="ask" data-term-ask>? Allow Bash: npm test</span>
<span class="ok" data-term-result></span></pre>
      <button type="button" class="term-go" data-claude><code>▸ Let Claude continue</code></button>
    </div>
    <div class="win wa" data-ui>
      <div class="win-bar"><span class="app-ic" style="--ic:#3BD16F" aria-hidden="true"><Fragment set:html={icons.chat} /></span>WhatsApp · Riya<span class="ctl" aria-hidden="true"><Fragment set:html={ctl} /></span></div>
      <div class="wa-body"><span class="bubble them">kal milte hain?</span><span class="bubble me" data-wa-sent hidden></span></div>
      <div class="wa-compose"><span>Type a message</span><button type="button" class="mic" data-talk aria-label="Hold to talk, or hold D"><Fragment set:html={icons.mic} /></button></div>
    </div>

    <div class="guide">
      <p class="g-title">Try these</p>
      <ul>
        <li>Circle <b>6E 2134</b> in the email</li>
        <li>Hold the mic in WhatsApp, or hold <kbd>D</kbd></li>
        <li>Let Claude continue in the Terminal</li>
        <li>Click the clock to ring an alarm</li>
        <li>Middle-click anywhere for the dial, or <button type="button" class="inline" data-dial-open>open it here</button></li>
      </ul>
    </div>
    <svg class="lasso" aria-hidden="true"><polyline points=""/></svg>
    <div class="dial" hidden></div>
    <div class="minute" hidden><p class="g-title">Your Shammy minute</p><p data-minute></p><a class="btn small" href={SETUP}>Download for Windows</a></div>
    <div class="flyout" hidden>
      <p class="g-title">Alarm</p>
      <label class="fly-row">Ring at <b data-hour-label></b><input type="range" min="0" max="23" data-hour aria-label="Alarm hour"></label>
      <button type="button" class="btn small" data-ring>Ring it now</button>
    </div>
    <div class="taskbar">
      <div class="tb-apps" aria-hidden="true">
        {['search', 'folder', 'globe', 'mail', 'term', 'chat', 'music'].map((k) => <span class:list={['tb-ic', { on: ['mail', 'term', 'chat'].includes(k) }]}><Fragment set:html={icons[k]} /></span>)}
      </div>
      <button type="button" class="tb-clock" data-clock-open aria-expanded="false" aria-label="Clock and alarm"><span data-clock></span><span data-date></span></button>
    </div>
  </div>
</section>

</Base>

<style>
  /* The journey: one stage stays on screen while the page scrolls past it. */
  .journey { position: relative; }
  .at { position: absolute; left: 0; width: 1px; height: 1px; }
  .stage { position: sticky; top: 68px; height: calc(100svh - 68px); min-height: 560px; overflow: hidden; isolation: isolate;
    --w0: rgba(107,63,216,.95); --w1: rgba(25,195,178,.85); --w2: rgba(224,87,122,.6); --w3: rgba(60,90,220,.5); }
  .world { position: absolute; inset: -10%; z-index: -2; filter: blur(50px) saturate(1.15); transition: background 1s;
    background: radial-gradient(34% 42% at 22% 32%, var(--w0), transparent 70%), radial-gradient(30% 40% at 78% 22%, var(--w1), transparent 70%), radial-gradient(40% 40% at 60% 94%, var(--w2), transparent 70%), radial-gradient(30% 34% at 45% 55%, var(--w3), transparent 70%), var(--ground); }
  .gl { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: 0; transition: opacity .8s ease; }
  .stage.gl-on .gl { opacity: 1; }
  .stage.gl-on .css-island { visibility: hidden; }
  .css-island { position: absolute; left: 50%; top: 50%; width: 600px; height: 80px; border-radius: 40px; display: flex; align-items: center; gap: 18px; padding: 0 32px; font-family: var(--app); transform-origin: 50% 50%; background: radial-gradient(40% 120% at 30% 120%, rgba(110,70,220,.35), transparent 70%), radial-gradient(40% 120% at 70% -20%, rgba(25,195,178,.25), transparent 70%), #08080C; box-shadow: inset 0 1px 0 rgba(255,255,255,.25), inset 0 -2px 0 rgba(140,200,220,.5), 0 30px 80px rgba(0,0,0,.6); }
  .ci-eyes { display: inline-flex; gap: 6px; } .ci-eyes i { width: 13px; height: 22px; border-radius: 7px; background: var(--ink); display: block; }
  .ci-status { margin-left: auto; font-weight: 600; font-size: 18px; }
  .ci-status:not(:empty)::before { content: ''; display: inline-block; width: 9px; height: 9px; margin-right: 10px; border-radius: 50%; background: #3BD16F; }
  .ci-time { font-weight: 700; font-size: 22px; padding-left: 16px; box-shadow: inset 1px 0 0 rgba(255,255,255,.18); }
  .ci-status:empty + .ci-time { margin-left: auto; box-shadow: none; }

  .open-copy { position: absolute; left: 0; right: 0; top: 6svh; text-align: center; padding: 0 var(--gutter-r) 0 var(--gutter); z-index: 2; }
  h1 { font-size: clamp(32px, 7.2vw, 108px); color: var(--ink); }
  .open-foot { position: absolute; left: 0; right: 0; bottom: 3.5svh; text-align: center; padding: 0 var(--gutter-r) 0 var(--gutter); z-index: 2; }
  .open-foot .lead { margin: 0 auto; max-width: 62em; text-wrap: balance; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px 26px; align-items: center; justify-content: center; margin-top: 22px; }

  .moments { position: absolute; inset: 0; pointer-events: none; perspective: 1200px; transform-style: preserve-3d; transform: scale(var(--spread, 1)); }
  .m { position: absolute; left: 50%; top: 50%; width: 330px; border-radius: 22px; padding: 14px 16px; font-size: 15px; transition: transform .3s ease-out; }
  .m small { color: var(--ink-soft); font-size: 13px; }
  .row { display: flex; align-items: center; gap: 10px; }
  .allow { margin-left: auto; height: 30px; padding: 0 14px; border-radius: 15px; background: var(--mint); color: #0B0A0E; display: inline-flex; align-items: center; font-weight: 700; font-size: 14px; }
  .code { display: block; font-size: 14px; margin-top: 6px; }
  .big-deva { font-size: 18px; margin-top: 6px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: #3BD16F; }
  .caps { text-transform: uppercase; letter-spacing: .1em; font-size: 12px; font-weight: 600; }
  .cover { border-radius: 10px; }
  .dawn { width: 250px; overflow: hidden; color: #fff; background: linear-gradient(180deg, #1E1626 0%, #5A2E3A 60%, #FFB070 100%); box-shadow: 0 24px 60px rgba(0,0,0,.45); }
  .dawn .sun { position: absolute; right: 22px; top: 24px; width: 52px; height: 52px; border-radius: 50%; background: radial-gradient(circle at 45% 40%, #FFF6E6, #FFA860); box-shadow: 0 0 40px 10px rgba(255,186,120,.5); }
  .dawn small { position: relative; color: rgba(255,255,255,.85); }
  .dawn-time { position: relative; font: 300 44px var(--display); letter-spacing: -.03em; } .dawn-time span { font-size: 15px; margin-left: 6px; }
  @media (max-width: 900px) { .moments { display: none; } }

  /* The island, open. Its parts are drawn by the story script, so they are styled globally here. */
  .isle { position: absolute; left: 50%; top: 9%; z-index: 3; overflow: hidden; transform-origin: 50% 0; opacity: 0; font-family: var(--app); color: #F4F3F0;
    background: radial-gradient(70% 90% at 12% 0%, rgba(107,63,216,.42), transparent 70%), radial-gradient(60% 80% at 95% 15%, rgba(25,195,178,.3), transparent 70%), rgba(10,10,15,.9);
    box-shadow: 0 40px 120px rgba(0,0,0,.6), inset 0 0 0 1px rgba(255,255,255,.09), inset 0 1px 0 rgba(255,255,255,.12); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); }
  .isle::after { content: ''; position: absolute; left: 12%; right: 12%; bottom: 0; height: 3px; background: linear-gradient(90deg, transparent, rgba(120,220,200,.9), rgba(160,140,255,.9), transparent); }
  [data-scene="music"] .isle { background: radial-gradient(70% 90% at 12% 0%, rgba(200,40,40,.55), transparent 70%), radial-gradient(60% 80% at 95% 85%, rgba(40,150,70,.45), transparent 70%), rgba(14,8,9,.9); }
  [data-scene="stage"] .isle { box-shadow: 0 0 0 8px rgba(255,214,180,.9), 0 0 120px 30px rgba(255,200,150,.35); }
  [data-scene="alarm"] .isle { background: transparent; }
  .isle-in { padding: 26px 30px 28px; }
  .isle :global(.eyes) { display: inline-flex; gap: 6px; flex: none; } .isle :global(.eyes i) { width: 13px; height: 21px; border-radius: 7px; background: #F4F3F0; }
  .isle :global(.cap) { font: 700 12px var(--app); letter-spacing: .12em; text-transform: uppercase; color: #A9A7A2; }
  .isle :global(.cap.on) { color: #F4F3F0; } .isle :global(.cap.center) { text-align: center; margin-top: 16px; }
  .isle :global(.c-head) { display: flex; align-items: center; gap: 14px; }
  .isle :global(.c-title) { font-size: 22px; font-weight: 700; margin-top: 4px; }
  .isle :global(.c-meta) { margin-left: auto; color: #A9A7A2; font-size: 14px; white-space: nowrap; }
  .isle :global(.c-meta.big) { color: #F4F3F0; font-size: 22px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .isle :global(.c-code) { display: block; margin-top: 18px; padding: 14px 16px; border-radius: 14px; background: rgba(0,0,0,.35); font: 16px var(--mono); }
  .isle :global(.c-acts) { display: flex; justify-content: flex-end; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .isle :global(.c-acts.start) { justify-content: flex-start; }
  .isle :global(.pill) { height: 46px; padding: 0 24px; border: 0; border-radius: 23px; display: inline-flex; align-items: center; font: 700 16px var(--app); color: #F4F3F0; background: rgba(255,255,255,.1); cursor: pointer; text-decoration: none; touch-action: none; }
  .isle :global(.pill:hover) { background: rgba(255,255,255,.18); }
  .isle :global(.pill.pri) { box-shadow: inset 0 0 0 2px #F9A3C0; }
  .isle :global(.pill.pri.on), .isle :global(.pill.pri.big) { background: #F9A3C0; color: #2A0F18; box-shadow: none; }
  .isle :global(.pill.big) { height: 54px; padding: 0 30px; font-size: 18px; }
  .isle :global(.rec) { width: 10px; height: 10px; border-radius: 50%; background: #FF5A5A; box-shadow: 0 0 12px #FF5A5A; }
  .isle :global(.wave) { margin-left: auto; display: flex; gap: 4px; align-items: center; height: 32px; }
  .isle :global(.wave i) { width: 5px; height: 26px; border-radius: 3px; background: rgba(255,255,255,.75); animation: wave 1s ease-in-out infinite alternate; }
  .isle :global(.wave i:nth-child(2n)) { animation-delay: -.4s; } .isle :global(.wave i:nth-child(3n)) { animation-delay: -.7s; }
  @keyframes wave { from { transform: scaleY(.3); } to { transform: scaleY(1); } }
  .isle :global(.c-said) { margin-top: 20px; font-size: 34px; font-weight: 600; min-height: 1.3em; }
  .isle :global(.c-said.deva) { font: 600 38px var(--deva); }
  .isle :global(.caret) { display: inline-block; width: 2px; height: 1em; margin-left: 3px; vertical-align: -.12em; background: var(--mint); animation: caret 1s steps(2) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  .isle :global(.switch) { display: inline-flex; padding: 4px; border-radius: 999px; background: rgba(255,255,255,.08); margin-right: auto; }
  .isle :global(.switch button) { height: 38px; border: 0; background: none; color: #F4F3F0; font: 600 15px var(--app); padding: 0 16px; border-radius: 999px; cursor: pointer; }
  .isle :global(.switch button.deva) { font-family: var(--deva); }
  .isle :global(.switch button[aria-pressed="true"]) { background: #F4F3F0; color: #0B0A0E; }
  .isle :global(.c-music) { display: flex; gap: 22px; align-items: center; }
  .isle :global(.c-music img) { width: 132px; height: 132px; border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,.5); flex: none; }
  .isle :global(.c-track) { flex: 1; min-width: 0; }
  .isle :global(.c-song) { font-size: 32px; font-weight: 800; margin-top: 6px; letter-spacing: -.01em; }
  .isle :global(.c-artist) { font-size: 16px; color: #D8C9C6; margin-top: 2px; }
  .isle :global(.c-bar), .isle :global(.c-progress) { margin-top: 18px; height: 5px; border-radius: 3px; background: rgba(255,255,255,.18); }
  .isle :global(.c-bar i) { display: block; height: 100%; border-radius: 3px; background: #F4F3F0; }
  .isle :global(.c-progress) { height: 6px; } .isle :global(.c-progress i) { display: block; height: 100%; border-radius: 3px; background: linear-gradient(90deg, #9FD8C2, #B9A4FF); }
  .isle :global(.c-times) { display: flex; justify-content: space-between; align-items: center; margin-top: 6px; font-size: 13px; color: #C9B9B6; font-variant-numeric: tabular-nums; }
  .isle :global(.play) { width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgba(255,255,255,.12); color: #F4F3F0; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .isle :global(.play svg) { width: 18px; height: 18px; }
  .isle :global(.c-prompt) { text-align: center; font-size: 30px; font-weight: 700; line-height: 1.3; color: rgba(244,243,240,.48); }
  .isle :global(.c-prompt .read) { color: #F4F3F0; }
