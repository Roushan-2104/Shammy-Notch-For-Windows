<script>
  const clock = () => new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
  const setClocks = () => document.querySelectorAll('[data-clock]').forEach((el) => { el.textContent = clock(); });
  setClocks(); setInterval(setClocks, 30000);

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const journey = document.querySelector('.journey') as HTMLElement;
  const stage = journey.querySelector('.stage') as HTMLElement;

  // The opening's moments drift with the pointer.
  const moments = [...stage.querySelectorAll<HTMLElement>('.m')];
  let mx = 0, my = 0;
  function placeMoments() {
    const w = stage.clientWidth, h = stage.clientHeight;
    for (const el of moments) {
      const x = +el.dataset.x! * w, y = +el.dataset.y! * h, z = +el.dataset.z!;
      el.style.transform = `translate(-50%,-50%) translate3d(${(x + mx * z * .9).toFixed(1)}px,${(y + my * z * .9).toFixed(1)}px,${z}px)`;
    }
  }
  stage.addEventListener('pointermove', (e) => { const r = stage.getBoundingClientRect(); mx = (e.clientX - r.left) / r.width - .5; my = (e.clientY - r.top) / r.height - .5; placeMoments(); });
  addEventListener('resize', placeMoments); placeMoments();

  // The alarm chapter speaks to the visitor's own hour.
  const hour = new Date().getHours(), night = hour >= 19 || hour < 5;
  const note = stage.querySelector('[data-sky-note]');
  if (note) note.textContent = night ? `It's ${clock()} where you are, so here it is under the moon.` : `It's ${clock()} where you are, so here it is in your sky.`;

  // The story and GSAP arrive just after the first screen.
  const story = import('../scripts/story.js').then(({ mountStory }) => mountStory(journey, { reduced, cover: journey.dataset.cover, release: journey.dataset.release, version: journey.dataset.version }));

  // The 3D island arrives once the page is on screen, on machines that can carry it.
  const canWebGL = (() => { try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; } })();
  if (!reduced && canWebGL && (navigator.hardwareConcurrency ?? 4) >= 4) {
    const start = () => import('../scripts/island.js').then(({ mountIsland }) => {
      const light = getComputedStyle(stage);
      const world = [0, 1, 2, 3].map((k) => light.getPropertyValue(`--w${k}`).match(/[\d.]+/g)!.map(Number));
      const island = mountIsland(stage, stage.querySelector('.gl'), world);
      story.then((s) => s.attach(island));
    }).catch(() => {});
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1500 }); else setTimeout(start, 600);
  }

  // The practice desktop, and its own glass island once it comes into view.
  const desk = document.querySelector('.desk') as HTMLElement;
  desk.querySelectorAll('[data-date]').forEach((el) => { el.textContent = new Date().toLocaleDateString('en-GB'); });
  // Leaving for another page: the island morphs into that page's island (where the browser supports it).
  addEventListener('pageswap', (e) => {
    if (!(e as any).viewTransition) return;
    const card = stage.querySelector('.isle') as HTMLElement, pill = stage.querySelector('.css-island') as HTMLElement;
    const from = card.style.visibility === 'visible' && stage.getBoundingClientRect().bottom > 0 ? card : pill;
    if (from === pill) pill.style.visibility = 'visible';
    from.style.viewTransitionName = 'island';
  });

  import('../scripts/desk.js').then(({ mountDesk }) => {
    mountDesk(desk);
    if (reduced || !canWebGL || (navigator.hardwareConcurrency ?? 4) < 4) return;
    const seen = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      seen.disconnect();
      import('../scripts/island.js').then(({ mountIsland }) => {
        const gl = mountIsland(desk, desk.querySelector('.desk-gl'), [[107, 63, 216, .75], [25, 140, 178, .6], [185, 164, 255, .35], [40, 30, 90, .6]]);
        const place = () => gl.place(desk.clientWidth / 2, 32, desk.clientWidth < 900 ? desk.clientWidth * .92 : 300);
        place(); addEventListener('resize', place);
        gl.tab(false); gl.world([[107, 63, 216, .75], [25, 140, 178, .6], [185, 164, 255, .35], [40, 30, 90, .6]], .7);
        desk.addEventListener('island', (ev) => gl.show(!(ev as CustomEvent).detail));
        desk.classList.add('gl-on');
      }).catch(() => {});
    }, { rootMargin: '200px' });
    seen.observe(desk);
  });
</script>
