---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { RELEASE, SETUP, APK } from '../site';
import dictation from '../captures/dictation.png';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Shammy, the island Windows was missing" description="A small island at the top of Windows. It holds Claude Code's questions, types what you say in Hinglish or Hindi, and brings your phone in. About 90 MB, free.">
<div class="page home">

<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title">Your PC finally has a notch. It floats.</h1>
  <div class="stage">
    <canvas class="gl" aria-hidden="true"></canvas>
    <div class="css-island" aria-hidden="true"><span class="isle-eyes"><i></i><i></i></span><span class="ci-status">Claude is done</span><span class="ci-time" data-clock></span></div>
  </div>
  <p class="lead">A small island at the top of Windows. It holds Claude Code's questions, types what you say in Hinglish or Hindi, and brings your phone's notifications to your laptop. Free, in about 90&nbsp;MB.</p>
  <div class="actions">
    <a class="btn" href={SETUP}>Download for Windows</a>
    <a class="link" href={APK}>Get the Android app</a>
  </div>
  <p class="meta">Windows 10 and 11. It updates itself, usually a few MB at a time.</p>
</section>

<section class="feature" id="features" aria-labelledby="claude-title">
  <div class="words">
    <p class="kicker">01 · Claude Code</p>
    <h2 id="claude-title">Claude asks. You answer from the top of your screen.</h2>
    <p class="lead">When Claude Code wants to run something, the island shows the command with Allow and Deny, over whatever app you're in. You stop checking the terminal every few minutes. Your phone can answer too, once it's unlocked.</p>
  </div>
  <div class="shot">
    <div class="isle-card ask" data-ask>
      <div class="ask-head"><span class="isle-eyes" aria-hidden="true"><i></i><i></i></span><b>Claude Code</b><span class="faint">wants to run</span><span class="faint mono where">login-fix</span></div>
      <code class="cmd">npm test</code>
      <div class="ask-acts" data-acts>
        <button type="button" class="pill" data-deny>Deny</button>
        <button type="button" class="pill go" data-allow>Allow</button>
      </div>
      <div class="ask-done"><span class="dot" aria-hidden="true" data-done hidden></span><span role="status" data-said></span><button type="button" class="pill quiet" data-again data-done hidden>Try again</button></div>
    </div>
  </div>
</section>

<section class="feature wide" aria-labelledby="talk-title">
  <div class="words two">
    <div>
      <p class="kicker">02 · Dictation</p>
      <h2 id="talk-title">Hold Ctrl + Win and talk. It types where your cursor is.</h2>
    </div>
    <p class="lead">English, Hinglish, or Hindi in Devanagari: say <span class="on">“Hindi mein”</span> first or last and it's typed in <span class="deva on" lang="hi">हिंदी</span>. Your words show up live in the island, and land in WhatsApp, Gmail or VS Code when you let go. It uses your own Gnani key.</p>
  </div>
  <figure class="shot">
    <Picture src={dictation} formats={['avif', 'webp']} fallbackFormat="webp" widths={[800, 1600]} sizes="(max-width: 1280px) 100vw, 1240px" alt="Dictation in three steps: the island shows your words live while you hold Ctrl and Win, then says Typed into WhatsApp, 15 words, with Undo, and the message appears in the chat." loading="lazy" />
    <figcaption>A real capture of Shammy, on test messages.</figcaption>
  </figure>
</section>

<section class="feature wide" aria-labelledby="light-title">
  <div class="words">
    <p class="kicker">03 · Light and free</p>
    <h2 id="light-title">Light enough to forget.</h2>
  </div>
  <dl class="ledger">
    <div><dt>90<span>MB</span></dt><dd>of memory while it sits there. Task Manager says so; we asked it twice.</dd></div>
    <div><dt>0</dt><dd>paid AI services. Plain things are answered on your PC.</dd></div>
    <div><dt>104<span>MB</span></dt><dd>installer. After that, updates are usually a few MB, in the background.</dd></div>
  </dl>
</section>

<section class="feature" aria-labelledby="phone-title">
  <div class="words">
    <p class="kicker">04 · Your phone</p>
    <h2 id="phone-title">Your phone joins the island.</h2>
    <p class="lead">Your phone's notifications show up on your laptop, and your laptop's on your phone. Send files, links and text between them over your own Wi-Fi, end-to-end encrypted.</p>
    <p class="aside"><a class="link" href={APK}>Get Shammy Island for Android 11+</a>, or scan the QR from the island's Phone button.</p>
  </div>
  <div class="shot stack" aria-hidden="true">
    <div class="isle-card note">
      <p class="cap">From your phone</p>
      <div class="note-row"><span class="app-dot wa"></span><div><b>Riya</b><span class="faint"> · WhatsApp</span><p>kal milte hain? 7 baje?</p></div></div>
    </div>
    <div class="isle-card note">
      <p class="cap">Sent to your phone</p>
      <div class="note-row"><span class="app-dot file"></span><div><b>trip-plan.pdf</b><p class="faint">2.4 MB · tap to open</p></div></div>
    </div>
  </div>
</section>

<section class="feature wide" aria-labelledby="stage-title">
  <div class="words two">
    <div>
      <p class="kicker">05 · Stage</p>
      <h2 id="stage-title">Read your script. Look at the lens.</h2>
    </div>
    <p class="lead">Stage puts your script right under the camera and follows your voice. Its ring light lights your face, and neither shows up when you share your screen.</p>
  </div>
  <figure class="shot">
    <video class="clip" src={`${base}/media/stage.mp4`} poster={`${base}/media/stage-poster.webp`} width="800" height="224" muted loop playsinline preload="none" aria-label="Stage scrolling a script line by line as it is read aloud"></video>
    <figcaption>Stage on a real call script. The line you're on stays bright.</figcaption>
  </figure>
</section>

<section class="get" id="download" aria-labelledby="get-title">
  <h2 id="get-title">Get Shammy. It's free.</h2>
  <p class="lead">It runs on Windows 10 (2004 or later) and 11, and updates itself in the background. MIT licence.</p>
  <div class="actions">
    <a class="btn" href={SETUP}>Download for Windows</a>
    <a class="link" href={RELEASE}>All releases</a>
  </div>
</section>

</div>
</Base>

<style>
  .home { --pad: clamp(72px, 9vw, 128px); }
  .home > section { max-width: var(--max); margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter-r); }

  .hero { padding-top: clamp(40px, 6vw, 72px); padding-bottom: var(--pad); text-align: center; }
  h1 { max-width: 13em; margin: 0 auto; font-weight: 600; font-size: clamp(40px, 6.4vw, 88px); line-height: 1.02; letter-spacing: -.035em; }
  .stage { position: relative; height: clamp(200px, 27vw, 340px); margin: 4px auto 0; max-width: 1100px; border-radius: 28px; overflow: hidden; }
  .gl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity .8s ease;
    -webkit-mask-image: radial-gradient(60% 50% at 50% 50%, #000 55%, transparent 100%); mask-image: radial-gradient(60% 50% at 50% 50%, #000 55%, transparent 100%); }
  .stage.gl-on .gl { opacity: 1; }
  .stage.gl-on .css-island { visibility: hidden; }
  .css-island { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(600px, 88%); height: 80px; border-radius: 40px; display: flex; align-items: center; gap: 18px; padding: 0 30px; font-family: var(--app); color: #F4F3F0; background: radial-gradient(40% 120% at 30% 120%, rgba(110,70,220,.35), transparent 70%), radial-gradient(40% 120% at 70% -20%, rgba(25,195,178,.25), transparent 70%), #08080C; box-shadow: inset 0 1px 0 rgba(255,255,255,.25), inset 0 -2px 0 rgba(140,200,220,.5), 0 30px 80px rgba(0,0,0,.6); }
  .ci-status { margin-left: auto; font-weight: 600; font-size: 17px; white-space: nowrap; }
  .ci-status::before { content: ''; display: inline-block; width: 9px; height: 9px; margin-right: 10px; border-radius: 50%; background: #3BD16F; }
  .ci-time { font-weight: 700; font-size: 21px; padding-left: 16px; box-shadow: inset 1px 0 0 rgba(255,255,255,.18); white-space: nowrap; }
  @media (max-width: 520px) { .ci-status { display: none; } .ci-time { margin-left: auto; box-shadow: none; } }
  .hero .lead { margin: 4px auto 0; text-wrap: balance; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px 26px; align-items: center; justify-content: center; margin-top: 28px; }
  .meta { margin-top: 16px; font-size: 15px; color: var(--ink-faint); }

  .feature { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr)); gap: 48px 72px; align-items: center; padding-top: var(--pad); padding-bottom: var(--pad); border-top: 1px solid rgba(255,255,255,.07); }
  .feature.wide { display: block; }
  .words.two { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr)); gap: 20px 72px; align-items: end; }
  .kicker { margin-bottom: 16px; font: 500 13px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); }
  h2 { font-weight: 600; font-size: clamp(32px, 3.6vw, 50px); line-height: 1.05; letter-spacing: -.03em; max-width: 15em; }
  .feature .lead { margin-top: 18px; max-width: 32em; }
  .words.two .lead { margin-top: 0; }
  .aside { margin-top: 16px; font-size: 16px; color: var(--ink-soft); }
  .deva.on { color: var(--ink); }
  .shot { margin: 0; }
  .feature.wide .shot { margin-top: 48px; }
  .shot :global(img), .clip { width: 100%; height: auto; border-radius: 24px; box-shadow: inset 0 0 0 1px rgba(255,255,255,.08); }
  .clip { display: block; max-width: 800px; margin: 0 auto; background: #120E1E; }
  figcaption { margin-top: 12px; font-size: 14px; color: var(--ink-faint); text-align: center; }

  /* Claude's question, as the island shows it. The buttons work. */
  .ask { max-width: 560px; margin: 0 auto; }
  .ask-head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 16px; white-space: nowrap; }
  @media (max-width: 520px) { .where { display: none; } .ask { padding: 18px 18px 20px; } }
  .faint { color: #A9A7A2; font-size: 15px; }
  .where { margin-left: auto; font-size: 13px; }
  .cmd { display: block; margin-top: 16px; padding: 14px 16px; border-radius: 14px; background: rgba(0,0,0,.35); font: 16px var(--mono); }
  .ask-acts, .ask-done { display: flex; align-items: center; justify-content: flex-end; gap: 10px; margin-top: 18px; min-height: 46px; }
  .ask-done { justify-content: flex-start; font-size: 16px; }
  .ask:not(.answered) .ask-done { margin: 0; min-height: 0; }
  .ask-done .pill { margin-left: auto; }
  .pill { height: 46px; padding: 0 22px; border: 0; border-radius: 23px; font: 700 15px var(--app); color: #F4F3F0; background: rgba(255,255,255,.1); cursor: pointer; transition: background .2s ease, transform .15s ease; }
  .pill:hover { background: rgba(255,255,255,.18); }
  .pill:active { transform: scale(.97); }
  .pill.go { background: var(--mint); color: #0B0A0E; }
  .pill.go:hover { background: #B8E6D4; }
  .pill.quiet { background: none; color: #A9A7A2; font-weight: 500; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: #3BD16F; flex: none; }
  .dot.no { background: var(--rose); }

  .ledger { margin: 40px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 32px 48px; }
  .ledger div { padding-top: 20px; border-top: 1px solid rgba(255,255,255,.1); }
  .ledger dt { font: 300 clamp(64px, 7vw, 104px)/1 var(--display); letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
  .ledger dt span { font-size: .32em; letter-spacing: 0; margin-left: 8px; color: var(--ink-soft); }
  .ledger dd { margin: 12px 0 0; max-width: 22em; font-size: 16px; line-height: 1.5; color: var(--ink-soft); }

  .stack { display: flex; flex-direction: column; gap: 16px; max-width: 480px; margin: 0 auto; width: 100%; }
  .stack .note:last-child { margin-left: clamp(0px, 6vw, 56px); }
  .cap { font: 700 12px var(--app); letter-spacing: .12em; text-transform: uppercase; color: #A9A7A2; }
  .note-row { display: flex; gap: 14px; align-items: flex-start; margin-top: 12px; font-size: 16px; }
  .note-row p { margin-top: 2px; }
  .app-dot { width: 40px; height: 40px; border-radius: 12px; flex: none; }
  .app-dot.wa { background: #1F6E4E; }
  .app-dot.file { background: #3B3A52; }

  .get { padding-top: var(--pad); padding-bottom: var(--pad); text-align: center; border-top: 1px solid rgba(255,255,255,.07); }
  .get h2 { margin: 0 auto; font-size: clamp(40px, 5.4vw, 72px); }
  .get .lead { margin: 18px auto 0; }
</style>

<script>
  const clock = () => new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
  const setClocks = () => document.querySelectorAll('[data-clock]').forEach((el) => { el.textContent = clock(); });
  setClocks(); setInterval(setClocks, 30000);

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The glass island arrives once the page is on screen, on machines that can carry it. Until then, and on the
  // rest, the flat island stands in.
  const stage = document.querySelector('.stage') as HTMLElement;
  const canWebGL = (() => {
    try {
      const probe = document.createElement('canvas').getContext('webgl2');
      probe?.getExtension('WEBGL_lose_context')?.loseContext();
      return !!probe;
    } catch { return false; }
  })();
  if (canWebGL && (navigator.hardwareConcurrency ?? 4) >= 4) {
    const start = () => import('../scripts/island.js').then(({ mountIsland }) => {
      mountIsland(stage, stage.querySelector('.gl'), { reduced });
      stage.classList.add('gl-on');
    }).catch(() => { /* the flat island stays */ });
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 }); else setTimeout(start, 400);
  }

  // Claude's question: Allow or Deny, then the answer, then ask again.
  const ask = document.querySelector('[data-ask]') as HTMLElement;
  // The status line stays in the page so screen readers hear the answer; only its dot and button come and go.
  const acts = ask.querySelector('[data-acts]') as HTMLElement, done = [...ask.querySelectorAll<HTMLElement>('[data-done]')];
  const said = ask.querySelector('[data-said]') as HTMLElement, dot = ask.querySelector('.ask-done .dot') as HTMLElement;
  const show = (answered: boolean) => { ask.classList.toggle('answered', answered); acts.hidden = answered; done.forEach((el) => { el.hidden = !answered; }); };
  const answer = (allowed: boolean) => {
    said.textContent = allowed ? 'Allowed. Claude carries on.' : 'Denied. Nothing runs.';
    dot.classList.toggle('no', !allowed);
    show(true);
    (ask.querySelector('[data-again]') as HTMLElement).focus();
  };
  ask.querySelector('[data-allow]')!.addEventListener('click', () => answer(true));
  ask.querySelector('[data-deny]')!.addEventListener('click', () => answer(false));
  ask.querySelector('[data-again]')!.addEventListener('click', () => {
    said.textContent = ''; show(false);
    (ask.querySelector('[data-allow]') as HTMLElement).focus();
  });

  // The Stage clip plays only while it's on screen. With reduced motion it waits for its own play button.
  const clip = document.querySelector('.clip') as HTMLVideoElement;
  if (reduced) clip.controls = true;
  else if ('IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => { if (e.isIntersecting) clip.play().catch(() => {}); else clip.pause(); }, { threshold: .4 }).observe(clip);
  }
</script>
